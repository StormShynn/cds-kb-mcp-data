{
  "name": "cds-kb-data",
  "version": "1.0.0",
  "private": true,
  "description": "Data + fetch/tag/enrich automation for the SAP CDS knowledge base. Consumed read-only by cds-kb-mcp-kit's MCP server (local clone or remote GitHub Contents API).",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "check-coverage": "node scripts/check-coverage.mjs",
    "check-coverage:html": "node scripts/check-coverage.mjs --html-only",
    "flag-release-state-review": "node scripts/flag-release-state-review.mjs",
    "add-hub-metadata": "node scripts/add_hub_metadata.mjs",
    "backfill-source-links": "node scripts/backfill_source_links.mjs",
    "enrich-ddl-fields": "node scripts/enrich_ddl_fields.mjs",
    "generate-dashboard": "node scripts/generate-dashboard.mjs",
    "generate-field-search": "node scripts/generate-field-search.mjs",
    "generate-search-page": "node scripts/generate-search-page.mjs .",
    "build-sqlite-index": "node scripts/build-sqlite-index.mjs .",
    "enrich-descriptions": "node scripts/enrich-descriptions.mjs .",
    "build-embeddings": "node scripts/build-embeddings.mjs .",
    "pull-usage-stats": "node scripts/pull-usage-stats.mjs",
    "pull-query-shapes": "node scripts/pull-query-shapes.mjs",
    "seed-query-proposals": "node scripts/seed-query-proposals-from-usage.mjs",
    "build-query-library-index": "node scripts/build-query-library-index.mjs",
    "sync-query-library-embed": "node scripts/sync-query-library-embed.mjs",
    "rebuild-index": "node enrich_index.mjs .",
    "resync-folders": "node scripts/migrate-to-module-folders.mjs . && node enrich_index.mjs .",
    "refresh-vsp-cookie": "node scripts/refresh-vsp-cookie.mjs"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@abaplint/core": "^2.120.39",
    "@huggingface/transformers": "^3.8.1",
    "playwright": "^1.55.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
