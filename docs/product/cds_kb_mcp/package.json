{
  "name": "cds-kb-mcp",
  "version": "2.6.0",
  "description": "Dataless MCP server for the SAP CDS knowledge base — search, compose, generate, and validate CDS view DDL. Built on the MCP 2026-07-28 SDK (stateless Streamable HTTP + stdio). In this harness, prefers sibling docs/product/cds_kb_data; otherwise S3 when configured, else GitHub remote. Explicit --data/--remote always win over sibling/default.",
  "type": "module",
  "bin": {
    "cds-kb-mcp": "dist/cds-kb-mcp.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node src/server.mjs",
    "start:local": "node src/server.mjs --data ../cds_kb_data",
    "start:remote": "node src/server.mjs --remote https://raw.githubusercontent.com/StormShynn/cds-kb-mcp-data-kit/main/docs/product/cds_kb_data",
    "test": "node test_tools.mjs ../cds_kb_data",
    "test:rrf": "node test_rrf.mjs",
    "test:eval": "node scripts/eval-compose.mjs ../cds_kb_data",
    "test:sap": "node test_sap_export.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "sap",
    "s4hana",
    "cds",
    "knowledge-base",
    "ai-agent",
    "claude"
  ],
  "dependencies": {
    "@abaplint/core": "^2.120.21",
    "@aws-sdk/client-s3": "^3.787.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "jose": "^6.0.10",
    "minisearch": "^7.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
